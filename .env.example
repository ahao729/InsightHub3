# InsightHub — 环境变量配置模板
# 复制为 .env 并修改后使用: cp .env.example .env

# ── 通用 ───────────────────────────────────────────────────
# nginx 监听端口（默认 80）
PORT=80

# ── 数据库 ──────────────────────────────────────────────────
# PostgreSQL 密码（默认: insighthub）
DB_PASSWORD=insighthub

# ── 后端 ────────────────────────────────────────────────────
# JWT 签名密钥（必须修改！生产环境请用强随机字符串）
JWT_SECRET=change-me-to-a-random-secret

# CORS 允许的源（逗号分隔，默认: http://localhost:80）
CORS_ORIGINS=http://localhost:80

# ── 爬虫（Scrapy）───────────────────────────────────────────
# Scrapy 设置模块路径
SCRAPY_SETTINGS_MODULE=crawler.settings
