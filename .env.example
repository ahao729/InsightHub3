# InsightHub — 环境变量配置模板
# 复制为 .env 并修改后使用: cp .env.example .env

# ── 通用 ───────────────────────────────────────────────────
# nginx 监听端口（默认 80）
PORT=80

# ── 数据库 ──────────────────────────────────────────────────
# PostgreSQL 密码（生产环境请替换为强随机字符串）
DB_PASSWORD=change-me-in-production

# ── 后端 ────────────────────────────────────────────────────
# JWT 签名密钥（必须修改！生产环境请用强随机字符串）
JWT_SECRET=change-me-to-a-random-secret

# CORS 允许的源（逗号分隔，默认: http://localhost:80）
CORS_ORIGINS=http://localhost:80

# ── LLM Provider ──────────────────────────────────────────
# 至少配置一个 provider，AI 分析功能才能正常工作。
# 多 provider 时会自动构建 fallback 链：主 provider 失败后依次尝试备用。

# OpenAI（默认主 provider）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# DeepSeek（默认用于 reasoning 任务，也作为 fallback）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic Claude（fallback）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 智谱 GLM / Zhipu（OpenAI 兼容，fallback：glm-4-flash）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 各任务的模型覆盖（可选）
FAST_MODEL=gpt-4o-mini
ANALYSIS_MODEL=gpt-4o
REASONING_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-3-small

# ── Embedding ──────────────────────────────────────────────
EMBEDDING_DIMENSIONS=1536

# ── Langfuse 可观测性（可选）─────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Token 用量与限速 ──────────────────────────────────────
TOKEN_TRACKING_ENABLED=true
DAILY_TOKEN_LIMIT=1000000
USER_DAILY_TOKEN_LIMIT=100000

# ── 爬虫（Scrapy）───────────────────────────────────────────
# Scrapy 设置模块路径
SCRAPY_SETTINGS_MODULE=crawler.settings

# ── 管理员 ──────────────────────────────────────────────────
# 管理员邀请码（生产环境必须设置）
ADMIN_INVITE_CODE=INSIGHTHUB2024
# 管理员默认密码（生产环境强烈建议设置）
ADMIN_DEFAULT_PASSWORD=

# ── LLM Mock Mode ──────────────────────────────────────────
# 设为任意非空值可强制使用 mock 回复（无需 API Key，适合开发环境）
LLM_MOCK_MODE=

# ── 邮件（SMTP，密码重置等功能需要）─────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=InsightHub <no-reply@insighthub.data>
FRONTEND_URL=http://localhost:80
